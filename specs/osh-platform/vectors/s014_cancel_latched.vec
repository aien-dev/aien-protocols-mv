case cancel_latched
kind negative
exec host-logic
domain any
needs streams
# an interrupt with nobody parked is latched and interrupts the next call on that end only (ST4.7, ST11.8)
create R W A => OK
cancel W => OK
read R 1 => WOULD_BLOCK
write W "x" => INTERRUPTED
write W "x" => OK n=1
cancel R => OK
read R 1 => INTERRUPTED
read R 1 => OK n=1 data="x"
close R => OK
close W => OK
check empty
