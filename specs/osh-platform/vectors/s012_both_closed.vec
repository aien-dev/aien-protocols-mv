case both_closed
kind negative
exec host-logic
domain any
needs streams
# both ends closed: the pipe and its unread bytes are gone; double close is STALE (ST4.8)
create R W A => OK
write W "lost" => OK n=4
close W => OK
close R => OK
check empty
close R => STALE
close W => STALE
read R 1 => STALE
check empty
