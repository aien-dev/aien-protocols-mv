case handle_reuse
kind negative
exec host-logic
domain any
needs streams
# a closed handle never reaches the stream that later reuses its slot (ST3.2, ST3.3)
create R W A => OK
close R => OK
close W => OK
create R2 W2 A => OK
read R 1 => STALE
write W "x" => STALE
close R => STALE
cancel W => STALE
revoke W => STALE
write W2 "ok" => OK n=2
read R2 8 => OK n=2 data="ok"
close R2 => OK
close W2 => OK
check empty
